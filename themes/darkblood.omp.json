{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<#D7BA7D>\u250f[</>{{ .UserName }}<#D7BA7D>]</>",
          "type": "session"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<#D7BA7D>[</>{{ .HEAD }}<#D7BA7D>]</>",
          "type": "git"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<#D7BA7D>[</>\uf0e7<#D7BA7D>]</>",
          "type": "root"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<#D7BA7D>[x</>{{ reason .Code }}<#D7BA7D>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#ffffff",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "<#D7BA7D>\u2516[</>{{ .Path }}<#D7BA7D>]></>",
          "type": "path"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
